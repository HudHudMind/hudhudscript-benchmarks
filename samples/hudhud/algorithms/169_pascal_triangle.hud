fn pascal_tri(n) { 
    let r=[]; 
    for(let i=0; i<n; i=i+1){
        let row=[]; 
        for(let j=0; j<=i; j=j+1){
            if(j==0){ row.push(1); }
            else if(j==i){ row.push(1); }
            else{ row.push(r[i-1][j-1]+r[i-1][j]); }
        } 
        r.push(row);
    } 
    return r; 
}
let res = pascal_tri(5);
print("res=" + res[0][0]);
print("DONE");
