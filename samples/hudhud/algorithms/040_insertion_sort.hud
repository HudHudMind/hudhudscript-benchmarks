fn ins_sort(arr) { 
    let n=arr.length; 
    for(let i=1; i<n; i=i+1){
        let k=arr[i]; let j=i-1; 
        while(j>=0){
            if (arr[j] <= k) { break; }
            arr[j+1]=arr[j]; j=j-1;
        } 
        arr[j+1]=k;
    } 
    return arr; 
}
let res = ins_sort([3,1,4,2]);
print("res=" + res[0]);
print("DONE");
