abstract class Shape { public fn area() { return 0 } }
class Circle extends Shape { public fn area() { return 3.14 * self.r * self.r } }
let total = 0.0;
for (let i = 1; i < 20000; i = i + 1) {
    let c = new Circle();
    c.r = i % 10;
    total = total + c.area();
}
print("total=" + total);
print("DONE");
