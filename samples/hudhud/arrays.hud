let arr = [];
for (let i = 0; i < 50000; i = i + 1) { arr.push(i); }
let sum = 0;
for (let i = 0; i < arr.length; i = i + 1) { sum = sum + arr[i]; }
let grid = [];
for (let i = 0; i < 50; i = i + 1) {
    let row = [];
    for (let j = 0; j < 50; j = j + 1) { row.push(i * j); }
    grid.push(row);
}
let last = arr.pop();
print("sum=" + sum);
print("g=" + grid[49][49]);
print("last=" + last);
print("DONE");
