// 18_repro_optimizer_bounds_g22.hud — Repro for Issue 2: Optimizer Bounds Check on Internal Gates (G2.2)
// Scenario: A multi-step loop where a step exceeds ~32 instructions (allocations, concatenations,
// arithmetic pipelines) followed by an internal gate block jumping backward to a previous step.

let step_counter = 0;
let max_reps = 3;
let acc_state = 100;
let event_log = [];

loop OptimizerBoundsReproLoop {
    // Step 1: Entry and state initialization
    step step_init {
        result.iteration = 0;
        result.threshold = 3;
        result.accum = 0;
        event_log.push("INIT");
        gate g_init {
            when true -> step_compute_heavy
            else -> step_finalize
        }
    }

    // Step 2: Basic block with >32 instructions + internal gate
    step step_compute_heavy {
        // [1] Multiple string concatenations & allocations
        let p0 = "prefix_";
        let p1 = p0 + "token_1_";
        let p2 = p1 + "token_2_";
        let p3 = p2 + "token_3_";
        let p4 = p3 + "token_4_";
        let p5 = p4 + "token_5_";
        let p6 = p5 + "token_6_";
        let p7 = p6 + "token_7_";
        let p8 = p7 + "token_8_";
        let p9 = p8 + "token_9_";

        // [2] Multiple arithmetic & bitwise/modular operations
        let x1 = (result.accum + 7) * 3;
        let x2 = (x1 - 5) * 2;
        let x3 = (x2 + 11) % 97;
        let x4 = (x3 * 4) + 13;
        let x5 = (x4 - 3) * 2;
        let x6 = (x5 + 17) % 89;
        let x7 = (x6 * 3) + 19;
        let x8 = (x7 - 7) * 2;
        let x9 = (x8 + 23) % 73;

        // [3] Multiple array allocations & pushes
        let buffer = [];
        buffer.push(x1);
        buffer.push(x2);
        buffer.push(x3);
        buffer.push(x4);
        buffer.push(x5);
        buffer.push(x6);
        buffer.push(x7);
        buffer.push(x8);
        buffer.push(x9);

        // [4] Object allocation & property mutation
        let record = { id: result.iteration, tag: p9, len: buffer.length, val: x9 };
        result.accum = record.val;
        result.iteration = result.iteration + 1;
        step_counter = result.iteration;
        acc_state = result.accum;
        event_log.push("HEAVY_STEP_" + result.iteration);

        // Internal Gate in the middle of loop: Backward jump to step_init / step_compute_heavy
        gate g_backward_check {
            when result.iteration < result.threshold -> step_compute_heavy
            else -> step_verify_mid
        }
    }

    // Step 3: Middle verification gate before finalization
    step step_verify_mid {
        let is_valid = false;
        if (result.iteration >= result.threshold) {
            is_valid = true;
            event_log.push("VERIFY_MID_VALID");
        } else {
            event_log.push("VERIFY_MID_INVALID");
        }

        gate g_mid_decision {
            when is_valid -> step_finalize
            else -> step_compute_heavy
        }
    }

    // Step 4: Finalization step
    step step_finalize {
        event_log.push("FINALIZED");
        result.status = "SUCCESS";
        gate g_end {
            when true -> done
            else -> fail
        }
    }
}

run loop OptimizerBoundsReproLoop;

print("Total Iterations: " + step_counter);
print("Final Accumulator: " + acc_state);
print("Event Log: " + event_log.join(" -> "));
print("DONE");
