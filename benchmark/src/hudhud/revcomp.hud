let seed = 42;
fn next_char() {
    seed = (seed * 1103515245 + 12345) % 2147483648;
    return ((seed - (seed % 65536)) / 65536) % 4;
}
let start = Date.to_millis();
let dna_chars = [];
let i = 0;
while (i < 500000) {
    dna_chars.push("ACGT"[next_char()]);
    i = i + 1;
}
let dna = dna_chars.join("");
let comp = {};
comp["A"] = "T"; comp["C"] = "G"; comp["G"] = "C"; comp["T"] = "A";
comp["a"] = "T"; comp["c"] = "G"; comp["g"] = "C"; comp["t"] = "A";
let R = 10;
let final_count = 0;
let r = 0;
while (r < R) {
    let count_A = 0;
    let i = dna.length - 1;
    while (i >= 0) {
        let c = comp[dna[i]];
        if (c == null) { c = dna[i]; }
        if (c == "A") { count_A = count_A + 1; }
        i = i - 1;
    }
    final_count = count_A;
    r = r + 1;
}
let end = Date.to_millis();
print("Result: " + final_count);
print("Time: " + (end - start) + "ms");
