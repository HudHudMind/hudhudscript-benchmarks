let K = 2000;
let seed = 12345;
fn ri(m) {
    seed = (seed * 16807) % 2147483647;
    return seed % m;
}

fn powmod(base, exp, mod) {
    let result = 1;
    while (exp > 0) {
        if (exp % 2 == 1) {
            result = (result * base) % mod;
        }
        exp = exp / 2;
        base = (base * base) % mod;
    }
    return result;
}

fn is_prime(n) {
    if (n < 2) { return 0; }
    if (n == 2) { return 1; }
    if (n % 2 == 0) { return 0; }

    let d = n - 1;
    let s = 0;
    while (d % 2 == 0) {
        d = d / 2;
        s = s + 1;
    }

    let witnesses = [2, 3, 5, 7];
    let wi = 0;
    while (wi < 4) {
        let a = witnesses[wi];
        if (a >= n) { wi = wi + 1; continue; }
        let x = powmod(a, d, n);
        if (x == 1 || x == n - 1) { wi = wi + 1; continue; }
        let r = 0;
        while (r < s - 1) {
            x = (x * x) % n;
            if (x == n - 1) { break; }
            r = r + 1;
        }
        if (x != n - 1) { return 0; }
        wi = wi + 1;
    }
    return 1;
}

let count = 0;
let i = 0;
let start = Date.to_millis();
while (i < K) {
    let base = 1000000001;
    let n = base + 2 * ri(500000000);
    if (is_prime(n)) {
        count = count + 1;
    }
    i = i + 1;
}
let end = Date.to_millis();
print("Result: " + count);
print("Time: " + (end - start) + "ms");
