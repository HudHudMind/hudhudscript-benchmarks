let seed = 42;
fn lcg() {
    seed = (seed * 1103515245 + 12345) % 2147483648;
    return ((seed - (seed % 65536)) / 65536) % 4;
}
let start = Date.to_millis();
let dna = "";
let i = 0;
while (i < 100000) {
    dna = dna + "ACGT"[lcg()];
    i = i + 1;
}
let ks = [1, 2, 3];
let result = 0;
let ki = 0;
while (ki < 3) {
    let k = ks[ki];
    let counts = {};
    let unique = 0;
    let i = 0;
    while (i <= 100000 - k) {
        let sub = dna.substring(i, i + k);
        let v = counts[sub];
        if (v == null) {
            counts[sub] = 1;
            unique = unique + 1;
        } else {
            counts[sub] = v + 1;
        }
        i = i + 1;
    }
    result = result + unique;
    ki = ki + 1;
}
let end = Date.to_millis();
print("Result: " + result);
print("Time: " + (end - start) + "ms");
