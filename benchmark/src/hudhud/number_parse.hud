let n = 200000;
let seed = 12345;
fn ri(m) {
    seed = (seed * 16807) % 2147483647;
    return seed % m;
}

let strings = [];
let i = 0;
while (i < n) {
    let s = "";
    if (ri(2) == 0) { s = "-"; }
    let nd = 1 + ri(9);
    s = s + (1 + ri(9));
    let j = 1;
    while (j < nd) { s = s + ri(10); j = j + 1; }
    strings.push(s);
    i = i + 1;
}

let start = Date.to_millis();
let total = 0;
let M = 1000003;
i = 0;
while (i < n) {
    let s = strings[i];
    let neg = false;
    let idx = 0;
    if (s[0] == "-") { neg = true; idx = 1; }
    let val = 0;
    while (idx < s.length) {
        let c = s[idx];
        let d = 0;
        if (c == "0") { d = 0; }
        else if (c == "1") { d = 1; }
        else if (c == "2") { d = 2; }
        else if (c == "3") { d = 3; }
        else if (c == "4") { d = 4; }
        else if (c == "5") { d = 5; }
        else if (c == "6") { d = 6; }
        else if (c == "7") { d = 7; }
        else if (c == "8") { d = 8; }
        else { d = 9; }
        val = val * 10 + d;
        idx = idx + 1;
    }
    if (neg) { val = 0 - val; }
    total = total + val;
    i = i + 1;
}
let r = ((total % M) + M) % M;
let end = Date.to_millis();
print("Result: " + r);
print("Time: " + (end - start) + "ms");
