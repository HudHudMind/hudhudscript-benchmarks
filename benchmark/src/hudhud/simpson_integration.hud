fn f(x) {
    return x * x * x - 2.0 * x * x + 3.0;
}

let N = 2000000;
let h = 10.0 / (N * 1.0);
let s = f(0.0) + f(10.0);

let start = Date.to_millis();

let i = 1;
while (i < N) {
    let x = (i * 1.0) * h;
    if (i % 2 == 0) {
        s = s + 2.0 * f(x);
    } else {
        s = s + 4.0 * f(x);
    }
    i = i + 1;
}

let result = s * h / 3.0;

let end = Date.to_millis();
print("Result: " + result);
print("Time: " + (end - start) + "ms");
