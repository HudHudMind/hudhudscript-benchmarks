let W = 20000;
let seed = 12345;
fn ri(n) {
    seed = (seed * 16807) % 2147483647;
    return seed % n;
}

let nodes = 1;
let children = [];
let terminal = [];
let i = 0;
while (i < 26) {
    children.push(0);
    i = i + 1;
}
terminal.push(0);

fn new_node() {
    let k = 0;
    while (k < 26) {
        children.push(0);
        k = k + 1;
    }
    terminal.push(0);
    nodes = nodes + 1;
    return nodes - 1;
}

let start = Date.to_millis();
let w = 0;
while (w < W) {
    let len = 3 + ri(6);
    let cur = 0;
    let j = 0;
    while (j < len) {
        let c = ri(26);
        let idx = cur * 26 + c;
        if (children[idx] == 0) {
            children[idx] = new_node();
        }
        cur = children[idx];
        j = j + 1;
    }
    terminal[cur] = 1;
    w = w + 1;
}

let hits = 0;
seed = 12345;
w = 0;
while (w < W) {
    let len = 3 + ri(6);
    let cur = 0;
    let j = 0;
    while (j < len) {
        let c = ri(26);
        let idx = cur * 26 + c;
        if (children[idx] == 0) {
            cur = 0;
            break;
        }
        cur = children[idx];
        j = j + 1;
    }
    if (cur != 0 && terminal[cur] == 1) {
        hits = hits + 1;
    }
    w = w + 1;
}

seed = 54321;
w = 0;
while (w < W) {
    let len = 3 + ri(6);
    let cur = 0;
    let j = 0;
    while (j < len) {
        let c = ri(26);
        let idx = cur * 26 + c;
        if (children[idx] == 0) {
            cur = 0;
            break;
        }
        cur = children[idx];
        j = j + 1;
    }
    if (cur != 0 && terminal[cur] == 1) {
        hits = hits + 1;
    }
    w = w + 1;
}


let end = Date.to_millis();
print("Result: " + nodes + "_" + hits);
print("Time: " + (end - start) + "ms");
