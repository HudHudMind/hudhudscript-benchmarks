let T = 300000;
let seed = 12345;
fn ri(m) {
    seed = (seed * 16807) % 2147483647;
    return seed % m;
}

let pq = [];
let qh = 0;
let wq = [];
let wh = 0;
let sq = [];
let sh = 0;

let made = 0;
let acc = 0;
let sunk = 0;

let start = Date.to_millis();
let t = 0;
while (t < T) {
    made = made + 1;
    if (made % 3 != 0) {
        let pkt = made % 100;
        wq.push(pkt);
    }

    if (wh < wq.length) {
        let pkt = wq[wh];
        wh = wh + 1;
        acc = (acc + pkt * 7) % 1000003;
        if (pkt > 50) {
            sq.push(pkt);
        }
    }

    if (sh < sq.length) {
        sh = sh + 1;
        sunk = sunk + 1;
    }

    t = t + 1;
}
let end = Date.to_millis();
print("Result: " + made + "_" + acc + "_" + sunk);
print("Time: " + (end - start) + "ms");
