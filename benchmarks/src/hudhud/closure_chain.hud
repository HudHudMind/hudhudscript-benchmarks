fn make_counter(start) {
    let c = start;
    return () => {
        c = c + 1;
        return c;
    };
}

let N = 150000;
let acc = 0;
let start = Date.to_millis();
let i = 0;
while (i < N) {
    let ctr = make_counter(i % 1000);
    acc = (acc + ctr() + ctr() + ctr()) % 1000003;
    i = i + 1;
}
let end = Date.to_millis();
print("Result: " + acc);
print("Time: " + (end - start) + "ms");
