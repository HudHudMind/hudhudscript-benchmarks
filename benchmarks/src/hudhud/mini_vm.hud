let I = 300000;
let acc = 0;
let counter = I;

let start = Date.to_millis();
while (counter > 0) {
    let op = counter % 10;
    if (op == 0) {
        acc = (acc * 3 + counter) % 1000003;
        counter = counter - 1;
    } else if (op == 1) {
        acc = (acc * 3 + counter) % 1000003;
        counter = counter - 1;
    } else if (op == 2) {
        acc = (acc * 3 + counter) % 1000003;
        counter = counter - 1;
    } else if (op == 3) {
        acc = (acc * 3 + counter) % 1000003;
        counter = counter - 1;
    } else if (op == 4) {
        acc = (acc * 3 + counter) % 1000003;
        counter = counter - 1;
    } else if (op == 5) {
        acc = (acc * 3 + counter) % 1000003;
        counter = counter - 1;
    } else if (op == 6) {
        acc = (acc * 3 + counter) % 1000003;
        counter = counter - 1;
    } else if (op == 7) {
        acc = (acc * 3 + counter) % 1000003;
        counter = counter - 1;
    } else if (op == 8) {
        acc = (acc * 3 + counter) % 1000003;
        counter = counter - 1;
    } else {
        acc = (acc * 3 + counter) % 1000003;
        counter = counter - 1;
    }
}
let end = Date.to_millis();
print("Result: " + acc);
print("Time: " + (end - start) + "ms");
