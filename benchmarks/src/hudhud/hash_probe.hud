let C = 65536;
let keys = [];
let vals = [];
let state = [];
let i = 0;
while (i < C) {
    keys.push(0);
    vals.push(0);
    state.push(0);
    i = i + 1;
}

let seed = 12345;
let I = 40000;
let L = 80000;
let D = 20000;
let found = 0;
let deleted = 0;
let acc = 0;

let start = Date.to_millis();
let j = 0;
while (j < I) {
    seed = (seed * 16807) % 2147483647;
    let k = (seed % 1000000) + 1;
    let h = (k * 16807) % C;
    while (state[h] == 1) {
        h = (h + 1) % C;
    }
    keys[h] = k;
    vals[h] = k % 97;
    state[h] = 1;
    j = j + 1;
}

let m = 0;
while (m < L) {
    seed = (seed * 16807) % 2147483647;
    let k = (seed % 1000000) + 1;
    let h = (k * 16807) % C;
    while (state[h] != 0) {
        if (state[h] == 1 && keys[h] == k) {
            found = found + 1;
            acc = (acc + vals[h]) % 1000003;
            break;
        }
        h = (h + 1) % C;
    }
    m = m + 1;
}

let n = 0;
while (n < D) {
    seed = (seed * 16807) % 2147483647;
    let k = (seed % 1000000) + 1;
    let h = (k * 16807) % C;
    while (state[h] != 0) {
        if (state[h] == 1 && keys[h] == k) {
            state[h] = 2;
            deleted = deleted + 1;
            break;
        }
        h = (h + 1) % C;
    }
    n = n + 1;
}

let end = Date.to_millis();
print("Result: " + found + "_" + deleted + "_" + acc);
print("Time: " + (end - start) + "ms");
