let n=200000;let U=400000;let parent=[];let size=[];let i=0
while(i<n){parent.push(i);size.push(1);i=i+1}
fn find(x){while(parent[x]!=x){x=parent[x]}return x}
fn union(a,b){let ra=find(a);let rb=find(b);if(ra!=rb){if(size[ra]<size[rb]){parent[ra]=rb;size[rb]=size[rb]+size[ra]}else{parent[rb]=ra;size[ra]=size[ra]+size[rb]}}}
let seed=12345;fn ri(m){seed=(seed*16807)%2147483647;return seed%m}
let start=Date.to_millis();let j=0
while(j<U){union(ri(n),ri(n));j=j+1}
let roots=0;i=0;while(i<n){if(parent[i]==i){roots=roots+1}i=i+1}
let end=Date.to_millis();print("Result: "+roots);print("Time: "+(end-start)+"ms")
