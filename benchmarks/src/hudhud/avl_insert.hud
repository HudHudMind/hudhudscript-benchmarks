let n = 100000;
let seed = 12345;
fn ri(m) { seed = (seed * 16807) % 2147483647; return seed % m; }

let sz = n + 10;
let key = []; let left = []; let right = []; let height = [];
let i = 0;
while (i < sz) { key.push(0); left.push(0); right.push(0); height.push(0); i = i + 1; }
let nodes = 0;

fn new_node(k) {
    nodes = nodes + 1;
    key[nodes] = k;
    left[nodes] = 0; right[nodes] = 0; height[nodes] = 1;
    return nodes;
}
fn get_h(nd) { if (nd == 0) { return 0; } return height[nd]; }
fn upd_h(nd) {
    let hl = get_h(left[nd]); let hr = get_h(right[nd]);
    if (hl > hr) { height[nd] = hl + 1; } else { height[nd] = hr + 1; }
}
fn bal(nd) { return get_h(left[nd]) - get_h(right[nd]); }
fn rot_r(y) {
    let x = left[y]; let t = right[x];
    right[x] = y; left[y] = t; upd_h(y); upd_h(x); return x;
}
fn rot_l(x) {
    let y = right[x]; let t = left[y];
    left[y] = x; right[x] = t; upd_h(x); upd_h(y); return y;
}
fn insert(nd, k) {
    if (nd == 0) { return new_node(k); }
    if (k < key[nd]) { left[nd] = insert(left[nd], k); }
    else if (k > key[nd]) { right[nd] = insert(right[nd], k); }
    else { return nd; }
    upd_h(nd); let b = bal(nd);
    if (b > 1 && k < key[left[nd]]) { return rot_r(nd); }
    if (b < -1 && k > key[right[nd]]) { return rot_l(nd); }
    if (b > 1 && k > key[left[nd]]) { left[nd] = rot_l(left[nd]); return rot_r(nd); }
    if (b < -1 && k < key[right[nd]]) { right[nd] = rot_r(right[nd]); return rot_l(nd); }
    return nd;
}

let root = 0; i = 0;
while (i < n) { root = insert(root, ri(1000000)); i = i + 1; }

let start = Date.to_millis();
let c = 0; let idx = 0;
let stack = []; let cur = root;
while (stack.length > 0 || cur != 0) {
    while (cur != 0) { stack.push(cur); cur = left[cur]; }
    cur = stack.pop();
    c = (c + key[cur] * (idx % 13)) % 1000003;
    idx = idx + 1;
    cur = right[cur];
}
let end = Date.to_millis();
print("Result: " + height[root] + "_" + c);
print("Time: " + (end - start) + "ms");
