let arr = [];
let i = 0;
while (i < 1000000) {
    arr.push(i + 1);
    i = i + 1;
}
let start = Date.to_millis();
let sum = 0.0;
i = 0;
while (i < 1000000) {
    sum = sum + arr[i];
    i = i + 1;
}
let mean = sum / 1000000.0;
let sq_diff = 0.0;
i = 0;
while (i < 1000000) {
    let diff = arr[i] * 1.0 - mean;
    sq_diff = sq_diff + diff * diff;
    i = i + 1;
}
let variance = sq_diff / 1000000.0;
let end = Date.to_millis();
let rm = mean * 10.0 + 0.5; rm = rm - rm % 1; rm = rm / 10.0;
let rv = variance * 10.0 + 0.5; rv = rv - rv % 1; rv = rv / 10.0;
print("Result: " + rm + "/" + rv);
print("Time: " + (end - start) + "ms");

