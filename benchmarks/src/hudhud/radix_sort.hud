let n = 200000;
let seed = 12345;
fn ri(m) {
    seed = (seed * 16807) % 2147483647;
    return seed % m;
}

let arr = [];
let i = 0;
while (i < n) {
    arr.push(ri(1000000));
    i = i + 1;
}

let start = Date.to_millis();

let buckets = [];
let k = 0;
while (k < 10) { buckets.push(0); k = k + 1; }
let output = [];
k = 0;
while (k < n) { output.push(0); k = k + 1; }

let p = 0;
while (p < 6) {
    k = 0;
    while (k < 10) { buckets[k] = 0; k = k + 1; }
    let div = 1;
    let t = 0;
    while (t < p) { div = div * 10; t = t + 1; }
    i = 0;
    while (i < n) {
        let d = (arr[i] / div) % 10;
        buckets[d] = buckets[d] + 1;
        i = i + 1;
    }
    k = 1;
    while (k < 10) { buckets[k] = buckets[k] + buckets[k - 1]; k = k + 1; }
    i = n - 1;
    while (i >= 0) {
        let d = (arr[i] / div) % 10;
        buckets[d] = buckets[d] - 1;
        output[buckets[d]] = arr[i];
        i = i - 1;
    }
    let tmp = arr;
    arr = output;
    output = tmp;
    p = p + 1;
}

let c = 0;
i = 0;
while (i < n) {
    c = (c + arr[i] * (i % 7)) % 1000003;
    i = i + 1;
}

let end = Date.to_millis();
print("Result: " + arr[0] + "/" + arr[n - 1] + "_" + c);
print("Time: " + (end - start) + "ms");
